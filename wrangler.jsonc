{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pillbug",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/worker.ts",
  // Root config has no bindings or routes. Deployments are handled by CI only.
  // Developers use `wrangler dev` locally; the dev token has no deploy permissions.
  "triggers": {
    "crons": ["0 3 * * *"],
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "pillbug.ianjmacintosh.com",
          "custom_domain": true,
        },
      ],
      "browser": { "binding": "BROWSER" },
      "vars": {
        "APP_URL": "https://pillbug.ianjmacintosh.com",
        "CF_TEAM_DOMAIN": "https://banana-squad.cloudflareaccess.com",
        "CF_ACCESS_AUD": "11ac3cc55febe375f39ed5a63a1edb9842c12aa4a6f98953c9623d685cd13570",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pillbug",
          "database_id": "53f26238-40f7-4aac-a17e-d9717a39b74b",
          "migrations_dir": "migrations",
        },
      ],
    },
    "staging": {
      "workers_dev": true,
      "routes": [
        {
          "pattern": "pillbug-staging.ianjmacintosh.com",
          "custom_domain": true,
        },
      ],
      "browser": { "binding": "BROWSER" },
      "vars": {
        "APP_URL": "https://pillbug-staging.ianjmacintosh.com",
        "CF_TEAM_DOMAIN": "https://banana-squad.cloudflareaccess.com",
        "CF_ACCESS_AUD": "7774856702e0b9102401ef7e87bcd6f8bcb159bf110342da44b0f5bc9742d1e1",
        "EMAIL_MOCK": "true",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pillbug-staging",
          "database_id": "e6b3aec5-7d5f-4f2d-9baa-da2675290408",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
