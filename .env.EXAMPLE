# Retrieve this from the Cloudflare dashboard
CLOUDFLARE_API_TOKEN=abc123

# Resend API key — stored as a Cloudflare Workers secret in production
# Sending domain: mail.pillbug.ianjmacintosh.com
RESEND_API_KEY=re_your_key_here

# APP_URL is set in wrangler.jsonc vars (https://pillbug.ianjmacintosh.com)
# Override here only if you need to test email verification against a local server:
# APP_URL=http://localhost:5173

# VAPID public and private keys generated with `npx web-push generate-vapid-keys`
# Public key is safe to commit and may be later exposed to the browser by a thin env module (e.g., `src/env.ts`):
#   export const VAPID_PUBLIC_KEY = import.meta.env.VITE_VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=BFQm9CCTfyOEXOGi7QxIMcBoaIS7oMFkrx7QnhbkUWseXxrht64qEHBSZk_Rp70D6eqaxUCKj_Oxfj-d4rGga3s

# VAPID_PRIVATE_KEY is stored as a Cloudflare Workers secret

# Cloudflare Turnstile — protects registration from spam bots.
# TURNSTILE_SECRET_KEY is stored as a Cloudflare Workers secret in production.
# Use the always-passes test secret for local development:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# VITE_TURNSTILE_SITE_KEY is the public site key embedded in the frontend.
# Use the always-passes test site key for local development:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA