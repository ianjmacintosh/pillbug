# Retrieve this from the Cloudflare dashboard
CLOUDFLARE_API_TOKEN=abc123

# Resend API key — stored as a Cloudflare Workers secret in production
# Sending domain: mail.pillbug.ianjmacintosh.com
RESEND_API_KEY=re_your_key_here

# APP_URL is set in wrangler.jsonc vars (https://pillbug.ianjmacintosh.com)
# Override here only if you need to test email verification against a local server:
# APP_URL=http://localhost:5173

# VAPID public and private keys generated with `npx web-push generate-vapid-keys`
# Public key is safe to commit and may be later exposed to the browser by a thin env module (e.g., `src/env.ts`):
#   export const VAPID_PUBLIC_KEY = import.meta.env.VITE_VAPID_PUBLIC_KEY
VITE_VAPID_PUBLIC_KEY=BFQm9CCTfyOEXOGi7QxIMcBoaIS7oMFkrx7QnhbkUWseXxrht64qEHBSZk_Rp70D6eqaxUCKj_Oxfj-d4rGga3s

# VAPID_PRIVATE_KEY is stored as a Cloudflare Workers secret

# Cloudflare Turnstile — protects registration from spam bots.
# TURNSTILE_SECRET_KEY is stored as a Cloudflare Workers secret in production.
# Use the always-passes test secret for local development:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# VITE_TURNSTILE_SITE_KEY is the public site key embedded in the frontend.
# Use the always-passes test site key for local development:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# EMAIL_SECRET is the master secret for deriving email encryption keys (HKDF).
# Generate a random value for local development:
#   openssl rand -hex 32
EMAIL_SECRET=your_email_secret_here

# PIN_SECRET is the secret for HMAC-hashing PIN verification codes (HKDF).
# Kept separate from EMAIL_SECRET so PIN and email keys can be rotated independently.
# Generate a random value for local development:
#   openssl rand -hex 32
PIN_SECRET=your_pin_secret_here

# CF_TEAM_DOMAIN and CF_ACCESS_AUD are set as vars in wrangler.jsonc — no local override needed.
# To access /admin locally without Cloudflare Access, add CF_ACCESS_MOCK=true to .env or .dev.vars.
# See docs/testing.md. Never set in staging or production.

# MINIFLARE_CHROME_EXECUTABLE — arm64 Linux only. Chrome-for-Testing has no arm64 build;
# set this to the arm64 Chromium that Playwright installs so miniflare's browser binding
# works locally. Leave unset in CI (ubuntu-latest is x86-64, Chrome-for-Testing runs natively).
# Note: setting this also passes --no-sandbox to Chrome, which is required inside containers
# but disables the browser sandbox — only set this if you're in a containerized environment.
# Find the path: find ~/.cache/ms-playwright -name chrome -path "*/chromium-*/chrome-linux/chrome" | tail -1
# MINIFLARE_CHROME_EXECUTABLE=/home/node/.cache/ms-playwright/chromium-1223/chrome-linux/chrome

# EMAIL_MOCK — test-only. Do NOT set this here or in .dev.vars.
# Staging always mocks email via wrangler.jsonc vars (EMAIL_MOCK = "true").
# When true, the worker skips the Resend API and uses a no-op email sender for
# /api/register and /api/login. Never set in production.