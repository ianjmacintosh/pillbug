{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Bash(npm run db:users:local*)",
      "Bash(node*scripts/list-users.js*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "npm run format 2>/dev/null || true && npm run lint && npm run typecheck && npm run test:unit -- --run",
            "statusMessage": "Running pre-commit checks..."
          }
        ]
      }
    ]
  }
}
