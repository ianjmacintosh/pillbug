{
  "permissions": {
    "allow": [
      "Bash(npx vitest *)",
      "Bash(npm run test:unit *)",
      "Bash(npx playwright *)",
      "Bash(curl *)",
      "Bash(npx tsc *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "mcp__claude_ai_Ref__ref_search_documentation",
      "mcp__claude_ai_Ref__ref_read_url",
      "Bash(npx eslint *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(npm run db:users:local*)",
      "Bash(node*scripts/list-users.js*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/tmux-thinking.sh",
            "statusMessage": "Flagging tmux window as busy..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/tmux-permission.sh",
            "statusMessage": "Flagging tmux window as needing approval..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for d in .agents/skills/*/; do name=$(basename \"$d\"); [ ! -e \".claude/skills/$name\" ] && ln -sf \"$(pwd)/$d\" \".claude/skills/$name\"; done; exit 0",
            "statusMessage": "Syncing skills from .agents to .claude..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/rename-tmux-window.sh",
            "statusMessage": "Renaming tmux window..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/tmux-thinking.sh",
            "statusMessage": "Resetting tmux window to thinking..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npm run format 2>/dev/null || true && npm run lint && npm run typecheck && npm run test:unit -- --run",
            "if": "Bash(git commit*)",
            "statusMessage": "Running pre-commit checks..."
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/tmux-awaiting.sh",
            "statusMessage": "Flagging tmux window as awaiting input..."
          }
        ]
      }
    ]
  }
}
