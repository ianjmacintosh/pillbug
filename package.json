{
  "name": "pillbug",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:remote": "wrangler dev --remote",
    "deploy": "npx wrangler d1 migrations apply pillbug --remote && npx wrangler deploy",
    "deploy:preview": "npx wrangler d1 migrations apply pillbug --remote && npx wrangler versions upload",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest",
    "test:e2e": "npx playwright test --reporter=list",
    "claude:install": "curl -fsSL https://claude.ai/install.sh | bash"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.169.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.23.1",
    "@cloudflare/workers-types": "^4.20260505.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.63.0"
  }
}
