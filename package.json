{
  "name": "pillbug",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-migrations.js && CLOUDFLARE_ENV=staging vite --host",
    "dev:wrangler": "wrangler dev --config wrangler.jsonc --env staging --ip 0.0.0.0",
    "dev:login": "node --env-file=.env scripts/seed-test-accounts.js && node --env-file=.env scripts/dev-login.js",
    "db:migrate:local": "wrangler d1 migrations apply pillbug-staging --env staging --local",
    "db:migrate:debug": "node scripts/debug-migration.js",
    "db:seed:local": "node --env-file-if-exists=.env scripts/seed-test-accounts.js",
    "db:users:local": "node --env-file=.env scripts/list-users.js",
    "db:reset:local": "ss -tlnp 2>/dev/null | grep -q :5173 && echo 'Stop the dev server before resetting the database.' && exit 1; rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "dev:remote": "wrangler dev --env staging --remote",
    "deploy": "npm run deploy:production",
    "deploy:production": "npx wrangler d1 migrations apply pillbug --env production --remote && npx wrangler deploy --env production",
    "deploy:staging": "npx wrangler d1 migrations apply pillbug-staging --env staging --remote && npx wrangler deploy --env staging",
    "deploy:preview": "npx wrangler d1 migrations apply pillbug-staging --env staging --remote && npx wrangler versions upload --env staging",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest",
    "test:e2e": "npx playwright test --reporter=list",
    "test:e2e:html": "npx playwright test --reporter=list,html",
    "claude:install": "curl -fsSL https://claude.ai/install.sh | bash",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.32",
    "@cloudflare/puppeteer": "^1.1.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@tanstack/react-router": "^1.169.2",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.8",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.2",
    "@cloudflare/workers-types": "^4.20260505.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "prettier": "3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "unpdf": "^1.6.2",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.100.0"
  }
}
